# Supabase-Projekt (Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur serverseitig verwenden, nie an den Client durchreichen. Umgeht RLS
# vollständig (lib/supabase/admin.ts) — benötigt vom Stripe-Webhook-Handler
# (app/api/stripe/webhook/route.ts), von lib/actions/billing.ts und von
# deleteAccount in lib/actions/auth.ts. Die Aufrufmuster sind in
# lib/supabase/admin.ts kommentiert.
SUPABASE_SECRET_KEY=

# Mapbox (account.mapbox.com → Tokens)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Stripe (dashboard.stripe.com → Developers → API keys)
# Serverseitig, nie an den Client durchreichen.
STRIPE_SECRET_KEY=
# Client-seitig sichtbar (Payment Element) — bewusst öffentlich, kein Secret.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Aus dem Webhook-Endpoint in Stripe (Developers → Webhooks), zur Prüfung
# des stripe-signature-Headers in app/api/stripe/webhook/route.ts.
STRIPE_WEBHOOK_SECRET=
# Price-IDs des Premium-Abos (Product Catalog → Preis auswählen). Ein Plan
# wird serverseitig auf genau eine dieser IDs abgebildet (lib/actions/billing.ts)
# — eine vom Client übergebene Price-ID wird nie verwendet.
STRIPE_PREMIUM_PRICE_ID_MONAT=
STRIPE_PREMIUM_PRICE_ID_JAHR=
# Gründerpreis (CHF 39/Jahr, die ersten 100 Abos — AGB Ziff. 4.3). Ein
# eigener, wiederkehrender Jahrespreis im selben Produkt. Der Plan ist NICHT
# wählbar: der Server vergibt ihn beim Jahresabo, solange noch ein Platz frei
# ist (gruenderplatz_beanspruchen, Migration 0065). Bleibt die Variable leer,
# gilt für alle der reguläre Jahrespreis — die Aktion ist dann schlicht aus.
STRIPE_PREMIUM_PRICE_ID_GRUENDER=
# Alt, nur noch Fallback für den Monatsplan, damit bestehende Konfigurationen
# ohne Anpassung weiterlaufen. Neu bitte STRIPE_PREMIUM_PRICE_ID_MONAT setzen.
STRIPE_PREMIUM_PRICE_ID=

# Secret für den nächtlichen Premium-Abgleich
# (app/api/cron/premium-abgleich/route.ts). Vercel sendet es als
# "Authorization: Bearer ..."; ohne gesetztes Secret bleibt der Endpunkt
# geschlossen. Beliebiger langer Zufallswert.
CRON_SECRET=

# Optional: Basis-URL für Redirects, die außerhalb eines Request-Kontexts
# gebaut werden (z. B. Stripe Customer Portal Rückkehr-Link in
# lib/actions/billing.ts). Fällt ohne Angabe auf http://localhost:3000
# zurück — in Preview/Production explizit setzen.
NEXT_PUBLIC_SITE_URL=

# Optional: Basis-URL der Marketing-Website, unter der Impressum,
# Datenschutzerklärung und AGB liegen (Repo janlampert08-dev/cornice.ch,
# Verzeichnis legal/). LEGAL_URLS in lib/constants.ts hängt die Pfade
# /legal/impressum, /legal/datenschutz und /legal/agb an.
#
# Ohne Angabe (oder leer) wird https://cornice-ch.vercel.app angenommen —
# die Adresse, unter der die Seiten heute tatsächlich stehen. Eine eigene
# Domain ist noch nicht registriert; sobald sie es ist und bei Vercel hängt,
# gehört sie hier hinein.
NEXT_PUBLIC_LEGAL_BASE_URL=
