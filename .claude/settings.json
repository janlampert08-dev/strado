{
  "permissions": {
    "allow": [
      "Bash(supabase migration new*)"
    ],
    "ask": [
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__rebase_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__create_branch",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__deploy_edge_function",
      "mcp__Supabase__confirm_cost",
      "mcp__Stripe__stripe_api_write",
      "mcp__Stripe__manage_stripe_accounts",
      "mcp__Vercel__deploy_to_vercel",
      "mcp__Vercel__create_git_project",
      "mcp__Vercel__pause_project",
      "mcp__Vercel__unpause_project",
      "mcp__Vercel__update_project_deployment_protection",
      "mcp__Vercel__buy_addon",
      "mcp__Vercel__buy_credits",
      "mcp__Vercel__buy_domain",
      "mcp__Vercel__buy_pro",
      "Bash(psql *)",
      "Bash(supabase db *)",
      "Bash(supabase migration list*)",
      "Bash(supabase migration up*)",
      "Bash(supabase migration repair*)",
      "Bash(supabase migration squash*)",
      "Bash(supabase migration fetch*)",
      "Bash(pg_dump *)",
      "Bash(pg_restore *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/sql-guard.sh\"",
            "timeout": 10,
            "statusMessage": "SQL-Check"
          }
        ]
      }
    ]
  }
}
